    "@react-navigation/native": "^7.1.6",
    "expo": "^55.0.20",
    "expo-blur": "~55.0.14",
    "expo-constants": "~55.0.15",
    "expo-dev-client": "~55.0.32",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.9",
    "expo-linking": "~55.0.14",
    "expo-router": "~55.0.13",
    "expo-sensors": "~55.0.13",
    "expo-splash-screen": "~55.0.19",
    "expo-status-bar": "~55.0.5",
    "expo-symbols": "~55.0.7",
