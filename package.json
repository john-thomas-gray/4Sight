    "@types/react": "~19.1.10",
    "@types/react-native": "^0.72.8",
    "ajv": "^7.2.4",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.10.19",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "postcss": "^8.5.6",
    "react-test-renderer": "^19.1.0",
    "tailwindcss": "3",
    "typescript": "~5.9.2"
