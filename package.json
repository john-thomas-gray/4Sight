    "@types/react": "~19.2.10",
    "ajv": "^7.2.4",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.10.19",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "postcss": "^8.5.6",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "3",
    "typescript": "~6.0.3",
    "@react-native/jest-preset": "^0.86.3"
  },
